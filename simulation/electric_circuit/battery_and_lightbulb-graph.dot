digraph  {
	subgraph cluster_s1 {
		fillcolor="#e2c6fc";style="dashed,filled";
		n2[color="green",fontname="Courier New",label=<
	<table border="0" cellborder="0" cellspacing="10">
			
			<tr>
				<td>Description:</td><td>simple electric simulation</td>
			</tr>
			
		
			

			
	</table>
	>,shape="plaintext"];
		
	}
	subgraph cluster_s9 {
		color="black";label="battery";margin="20";penwidth="5";style="rounded";
		n11[fontname="Courier New",group="battery",height="1.0",label="power_demand",penwidth="2.5",shape="circle",style="filled",width="1.0"];
		n12[fontname="Courier New",group="battery",height="1.0",label="power_supply",penwidth="2.5",shape="circle",style="filled",width="1.0"];
		n10[color="#9dddea",fontname="Courier New",group="battery",height="1.0",label="electric battery with initial charge level",penwidth="2.5",shape="rect",style="filled",width="1.0"];
		n11->n10;
		n10->n12;
		
	}
	subgraph cluster_s3 {
		color="black";label="lightbulb";margin="20";penwidth="5";style="rounded";
		n5[fontname="Courier New",group="lightbulb",height="1.0",label="power_supply",penwidth="2.5",shape="circle",style="filled",width="1.0"];
		n6[fontname="Courier New",group="lightbulb",height="1.0",label="start_power_demand",penwidth="2.5",shape="circle",style="filled",width="1.0"];
		n7[fontname="Courier New",group="lightbulb",height="1.0",label="light_supply",penwidth="2.5",shape="circle",style="filled",width="1.0"];
		n8[fontname="Courier New",group="lightbulb",height="1.0",label="power_demand",penwidth="2.5",shape="circle",style="filled",width="1.0"];
		n4[color="#9dddea",fontname="Courier New",group="lightbulb",height="1.0",label="electric lightbulb",penwidth="2.5",shape="rect",style="filled",width="1.0"];
		n5->n4;
		n6->n4;
		n4->n7;
		n4->n8;
		
	}
	layout="dot";splines="ortho";
	n12->n5[color="#e437ea",minlen="3",penwidth="2"];
	n8->n11[color="#e437ea",minlen="3",penwidth="2"];
	
}
