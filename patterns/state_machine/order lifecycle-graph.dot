	<table border="0" cellborder="0" cellspacing="10">
			
			<tr>
				<td>Description:</td><td>a state machine: states are components, transitions are pipes leaving event-named ports, a guard sits on its pipe</td>
			</tr>
			
		
			

			
	</table>
	>,shape="plaintext"];
		
	}
